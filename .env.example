# Admin API key (NOT Click API token). Never commit the real .env!
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=REPLACE_WITH_YOUR_ADMIN_API_KEY
# Set your OWN surname. Only names beginning with this exact prefix are accepted.
CAMPAIGN_PREFIX=test_yoursurname_
# Normal operation: creation and Push work only on owned campaigns, after explicit UI confirmation.
# Emergency read-only mode: set false. Local draft edits and Cancel continue to work.
KEITARO_WRITE_ENABLED=true
# Docker Compose connection string (local development instructions in README)
DATABASE_URL=postgresql+psycopg://wrapper:wrapper_local_only@db:5432/wrapper
# For this submission run locally only; Docker maps 127.0.0.1.

# OPTIONAL defaults: choose EXISTING IDs from /api/lookups, never guess or copy a stranger's.
# If absent, select a value in the form's 'Дополнительные настройки'.
# CAMPAIGN_DOMAIN_ID=123
# CAMPAIGN_GROUP_ID=456
# CAMPAIGN_TRAFFIC_SOURCE_ID=789
